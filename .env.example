# Copy to .env.production.local (git-ignored) for `npm run deploy:web`.
# Supabase dashboard → Project Settings → API. Both values are public by design:
# they ship inside the website. Never put the secret or service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# How people sign in. number (default while testing): mobile number, no code or
# password. For launch: phone (one-time code), email, or phone,email. Phone codes
# need an SMS provider and DLT registration. See docs/LAUNCH.md step 3.
# EXPO_PUBLIC_SIGNIN=number

# The website's server reads only the EAS production environment, never these
# files: add both Supabase values there too (plain text), see docs/LAUNCH.md step 7.

# Server-only, for the voice assistant (/api/assist): one of these. Claude is used
# when its key is set, else Groq's free tier (console.groq.com). Put it in .env.local
# for local runs and in the EAS production environment for the website (eas
# env:create, --visibility sensitive; EAS Hosting cannot read "secret" ones).
# Never prefix it with EXPO_PUBLIC_, never commit it, never paste it in chat.
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Local development only, in .env.local: lets /api/assist answer without a
# Supabase backend (no sign-in or daily limit). Never set it for a deploy.
# ASSIST_OPEN_DEV=1
